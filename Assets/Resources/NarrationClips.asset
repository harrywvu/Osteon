    clip: {fileID: 8300000, guid: 99225b408ad95240b1d5542abf2246ee, type: 3}
  - text: "Default dark"
    clip: {fileID: 8300000, guid: c3d6ecc698375b8dbaea15e2f62c3853, type: 3}
  - text: "Light"
    clip: {fileID: 8300000, guid: 2c955b4243ec53628b2f3223ed13430f, type: 3}
  - text: "High contrast"
    clip: {fileID: 8300000, guid: 949129fa849a57e588497ba73bdce024, type: 3}
  - text: "Text size"
    clip: {fileID: 8300000, guid: 42ba48b69ba65280948935e119b76736, type: 3}
  - text: "Small"
    clip: {fileID: 8300000, guid: d5d4e693d89d510bbf7a1ee296d30f0c, type: 3}
  - text: "Standard"
    clip: {fileID: 8300000, guid: 5662c4e7f870561ebecc733981682adf, type: 3}
  - text: "Large"
    clip: {fileID: 8300000, guid: 7136ece42ad7577bb4e4aee3e448feb4, type: 3}
  - text: "Highlight color"
    clip: {fileID: 8300000, guid: 3aed1b9f4cfe5e01a04a67fdb7ef5808, type: 3}
  - text: "Original blue"
    clip: {fileID: 8300000, guid: b48fbf75a9f75d4e88ce9e8355d55c3c, type: 3}
  - text: "Amber"
    clip: {fileID: 8300000, guid: d635a5bb62bc5dcfbc7fd06813e6f1c4, type: 3}
  - text: "Violet"
    clip: {fileID: 8300000, guid: 6bb27c50b0b15a7d85b084e8263154a5, type: 3}
  - text: "Lime"
    clip: {fileID: 8300000, guid: 93d0eb1ae8345a5d952bea374aad227a, type: 3}
  - text: "Aim your controller ray at the skeleton and press Select. Choose Axial or Appendicular."
    clip: {fileID: 8300000, guid: 8e17ab04178f523eba44ed91244e25f4, type: 3}
  - text: "Select a highlighted bone group to look closer."
    clip: {fileID: 8300000, guid: 742f083d15e75c46aa1af4aa82437ac5, type: 3}
  - text: "Point at a bone to see its name, then select it."
    clip: {fileID: 8300000, guid: 2bd085ccb4de5a499868484168b28670, type: 3}
  - text: "Move the right stick sideways to turn the bone."
    clip: {fileID: 8300000, guid: 15ac815908b25d14a042c9c525d58723, type: 3}
  - text: "Move the right stick up or down to tilt it."
    clip: {fileID: 8300000, guid: 95346bef6a3f5aa097811bedff6eda5e, type: 3}
  - text: "Press left X or use Back on the panel. Keep going until you reach the whole skeleton."
    clip: {fileID: 8300000, guid: e0358f4998eb5a1d95398f16a6b3d375, type: 3}
  - text: "You're ready to explore. A resets turn; B resets tilt. Use Spread in multi-bone groups."
    clip: {fileID: 8300000, guid: 9dec0cf657085e5ab13087077adbebc9, type: 3}
