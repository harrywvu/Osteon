    clip: {fileID: 8300000, guid: 47a4e51b65345c23a46e4ecea7e3d75e, type: 3}
  - text: "Warm"
    clip: {fileID: 8300000, guid: 5c3b283e51385fb4b5d98b467fccb38a, type: 3}
